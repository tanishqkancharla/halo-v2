{
  "name": "halo-v2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "halo-web": "pnpm --silent --filter @halo/web-cli cli",
    "infra:deploy": "pnpm --filter @halo/infra run deploy",
    "infra:dev": "pnpm --filter @halo/infra run dev",
    "infra:login": "pnpm --filter @halo/infra run login",
    "infra:plan": "pnpm --filter @halo/infra run plan",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck lint format:check test --affected",
    "check-affected": "pnpm run check"
  },
  "devDependencies": {
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "turbo": "^2.10.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0"
}

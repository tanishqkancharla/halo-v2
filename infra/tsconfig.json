{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": ".",
    "target": "ESNext",
    "types": ["node"]
  },
  "include": ["alchemy.run.ts", "src/**/*.ts"],
  "exclude": ["node_modules", ".alchemy"]
}

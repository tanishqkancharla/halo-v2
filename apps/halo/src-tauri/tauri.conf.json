{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halo",
  "version": "0.1.0",
  "identifier": "com.saffronhealth.halo",
  "build": {
    "beforeDevCommand": "./node_modules/.bin/vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "./node_modules/.bin/vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Halo",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 16
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Medical",
    "externalBin": ["binaries/agentos-sidecar"],
    "resources": {
      "../node_modules/@agentos-software/pi/dist/package.aospkg": "agentos/pi.aospkg"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}

{
  "name": "@halo/desktop",
  "version": "0.1.33",
  "private": true,
  "description": "Halo desktop app",
  "license": "MIT",
  "author": "Saffron Health",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanishqkancharla/halo-v2.git"
  },
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "build": "electron-forge package",
    "dev": "electron-forge start",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "format": "oxfmt src forge index.html package.json tsconfig.json forge.config.ts vitest.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "format:check": "oxfmt --check src forge index.html package.json tsconfig.json forge.config.ts vitest.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings src forge forge.config.ts vitest.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix src forge forge.config.ts vitest.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "test": "vitest run src/main src/shared src/renderer/main/agent forge",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/main/tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@executor-js/codemode-core": "1.6.0",
    "@executor-js/execution": "1.6.0",
    "@executor-js/fumadb": "1.5.7",
    "@executor-js/plugin-openapi": "1.6.0",
    "@executor-js/runtime-quickjs": "1.6.0",
    "@executor-js/sdk": "1.6.0",
    "@halo/cli": "workspace:*",
    "@halo/plugin-sdk": "workspace:*",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.31.0",
    "@libsql/client": "0.17.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@orpc/client": "2.0.0-beta.29",
    "@orpc/server": "2.0.0-beta.29",
    "@parcel/watcher": "^2.6.0",
    "@pierre/diffs": "^1.3.5",
    "@pierre/trees": "1.0.0-beta.6",
    "@repo/logger": "workspace:*",
    "@repo/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "@streamdown/code": "^1.1.1",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/markdown": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "drizzle-orm": "0.45.0",
    "effect": "4.0.0-beta.59",
    "electron-squirrel-startup": "^1.0.1",
    "errore": "^0.14.1",
    "esbuild": "0.28.2",
    "jiti": "2.7.0",
    "maui": "npm:@tanishqkancharla/maui@0.0.13",
    "purse-styles": "^0.2.3",
    "quickjs-emscripten": "0.31.0",
    "react": "^19.2.8",
    "react-aria-components": "1.21.0",
    "react-dom": "^19.2.8",
    "streamdown": "^2.5.0",
    "typebox": "1.3.7",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@5.9.3",
    "update-electron-app": "^3.3.0",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@repo/typescript-config": "workspace:*",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "agentation": "^3.0.2",
    "agentation-mcp": "^1.2.0",

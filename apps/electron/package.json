{
  "name": "@halo/desktop",
  "version": "0.1.23",
  "private": true,
  "description": "Halo desktop app",
  "license": "MIT",
  "author": "Saffron Health",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanishqkancharla/halo-v2.git"
  },
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "build": "electron-forge package",
    "dev": "electron-forge start",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "format": "oxfmt src forge index.html package.json tsconfig.json tsconfig.main.json forge.config.ts vitest.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "format:check": "oxfmt --check src forge index.html package.json tsconfig.json tsconfig.main.json forge.config.ts vitest.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings src forge forge.config.ts vitest.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix src forge forge.config.ts vitest.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "test": "vitest run src/main src/shared src/renderer/agentSession forge",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.main.json"
  },
  "dependencies": {
    "@halo/cli": "workspace:*",
    "@halo/plugin-sdk": "workspace:*",
    "@mariozechner/pi-coding-agent": "0.60.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@orpc/client": "2.0.0-beta.29",
    "@orpc/contract": "2.0.0-beta.29",
    "@orpc/server": "2.0.0-beta.29",
    "@parcel/watcher": "^2.6.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@repo/logger": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "@streamdown/code": "^1.1.1",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/markdown": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "electron-squirrel-startup": "^1.0.1",
    "errore": "^0.14.1",
    "esbuild": "^0.28.1",
    "jiti": "2.7.0",
    "maui": "github:tanishqkancharla/maui#5b5a450900317e7f04a33bd4c2ac8a592442e6f0",
    "purse-styles": "^0.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.5.0",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@5.9.3",
    "update-electron-app": "^3.3.0",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@repo/typescript-config": "workspace:*",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "agentation": "^3.0.2",
    "agentation-mcp": "^1.2.0",
    "electron": "^43.2.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "productName": "Halo"
}

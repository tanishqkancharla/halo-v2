{
  "name": "@halo/desktop",
  "version": "0.1.5",
  "private": true,
  "description": "Halo desktop app",
  "license": "MIT",
  "author": "Saffron Health",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanishqkancharla/halo-v2.git"
  },
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "build": "electron-forge package",
    "dev": "electron-forge start",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "format": "oxfmt src index.html package.json tsconfig.json tsconfig.main.json forge.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "format:check": "oxfmt --check src index.html package.json tsconfig.json tsconfig.main.json forge.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "lint": "oxlint --deny-warnings src forge.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "lint:fix": "oxlint --fix src forge.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "test": "vitest run src/main src/shared",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.main.json"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "0.60.0",
    "@repo/logger": "workspace:*",
    "@streamdown/code": "^1.1.1",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/markdown": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@types/three": "^0.185.1",
    "capnweb": "^0.10.0",
    "electron-squirrel-startup": "^1.0.1",
    "errore": "^0.14.1",
    "maui": "npm:@tanishqkancharla/maui@0.0.2",
    "purse-styles": "^0.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.5.0",
    "three": "^0.185.1",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@repo/typescript-config": "workspace:*",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "agentation": "^3.0.2",
    "electron": "^43.2.0",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "productName": "Halo"
}

{
  "name": "@halo/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Halo desktop app",
  "author": "Saffron Health",
  "type": "module",
  "main": ".vite/build/main.js",
  "scripts": {
    "build": "electron-forge package",
    "dev": "electron-forge start",
    "make": "electron-forge make",
    "format": "oxfmt src index.html package.json tsconfig.json tsconfig.main.json forge.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "format:check": "oxfmt --check src index.html package.json tsconfig.json tsconfig.main.json forge.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "lint": "oxlint --deny-warnings src forge.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "lint:fix": "oxlint --fix src forge.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "test": "vitest run src/main",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.main.json"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "0.60.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/three": "^0.185.1",
    "electron-squirrel-startup": "^1.0.1",
    "maui": "github:tanishqkancharla/maui#cb99be2b6872afff0d865f9aba48cffa93ac6f98",
    "purse-styles": "^0.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "agentation": "^3.0.2",
    "electron": "^43.2.0",
    "typescript": "7.0.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "productName": "Halo"
}

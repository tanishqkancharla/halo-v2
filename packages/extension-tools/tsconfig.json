{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmitOnError": true,
    "outDir": "dist",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "test", "playwright.config.ts"],
  "exclude": ["test/fixtures"]
}

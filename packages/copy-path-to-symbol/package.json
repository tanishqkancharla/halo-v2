{
  "name": "halo-copy-path-to-symbol",
  "displayName": "Copy Path to Symbol",
  "version": "0.1.1",
  "private": true,
  "description": "Copy a workspace-relative file path with the current symbol or selected line range.",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "publisher": "halo",
  "main": "./extension.js",
  "scripts": {
    "test": "node --test symbolPath.test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "halo.copyPathToSymbol",
        "title": "Copy Path to Symbol"
      },
      {
        "command": "halo.copyPathToRange",
        "title": "Copy Path to Range"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "halo.copyPathToSymbol",
          "group": "navigation@20",
          "when": "editorTextFocus && !editorHasSelection"
        },
        {
          "command": "halo.copyPathToRange",
          "group": "navigation@20",
          "when": "editorTextFocus && editorHasSelection"
        }
      ],
      "commandPalette": [
        {
          "command": "halo.copyPathToSymbol",
          "when": "!editorHasSelection"
        },
        {
          "command": "halo.copyPathToRange",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "activationEvents": [
    "onCommand:halo.copyPathToRange",
    "onCommand:halo.copyPathToSymbol"
  ],
  "engines": {
    "vscode": "^1.85.0"
  }
}

{
  "name": "@halo/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "halo": "./bin/halo.cjs"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "cli": "node --import tsx src/cli.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings src",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix src",
    "test": "vitest run src --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orpc/client": "2.0.0-beta.29",
    "@sinclair/typebox": "^0.34.52",
    "errore": "^0.14.1",
    "incur": "^0.4.20"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}

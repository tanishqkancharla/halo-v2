    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@halo/plugin-sdk": "workspace:*",
    "@orpc/contract": "2.0.0-beta.29",

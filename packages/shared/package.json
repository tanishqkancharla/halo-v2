    "./connectionRequests": "./src/connectionRequests.ts",
    "./contract": "./src/contract.ts",
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings src",

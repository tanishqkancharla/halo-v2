{
  "name": "@get-halo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./agent": "./src/agent.ts",
    "./cli": "./src/cli.ts",
    "./filesystem": "./src/filesystem.ts",
    "./plugins": "./src/plugins.ts",
    "./router": "./src/router.ts",
    "./sessions": "./src/sessions.ts",
    "./workspace": "./src/workspace.ts"
  },
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings src",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix src",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@executor-js/codemode-core": "1.6.0",
    "@executor-js/execution": "1.6.0",
    "@executor-js/fumadb": "1.5.7",
    "@executor-js/plugin-openapi": "1.6.0",
    "@executor-js/runtime-quickjs": "1.6.0",
    "@executor-js/sdk": "1.6.0",
    "@get-halo/shared": "workspace:*",
    "@halo/plugin-sdk": "workspace:*",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.31.0",
    "@libsql/client": "0.17.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@orpc/server": "2.0.0-beta.29",
    "@parcel/watcher": "^2.6.0",
    "@repo/logger": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "0.45.0",
    "effect": "4.0.0-beta.59",
    "errore": "^0.14.1",
    "esbuild": "0.28.2",
    "jiti": "2.7.0",
    "quickjs-emscripten": "0.31.0",
    "typebox": "1.3.7",
    "typescript6": "npm:typescript@5.9.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}

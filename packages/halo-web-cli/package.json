{
  "name": "@halo/web-cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "halo-web": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "cli": "node --import tsx src/cli.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings src",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix src",
    "test": "vitest run src --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "errore": "^0.14.1",
    "incur": "^0.4.20",
    "libretto-browser-tools": "^0.1.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}

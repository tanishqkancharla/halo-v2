{
  "name": "@get-halo/tkstack",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "tkstack": "./src/cli.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "cli": "node --import tsx src/cli.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings src vite.config.ts",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix src vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pierre/diffs": "^1.3.5",
    "beautiful-mermaid": "^1.1.3",
    "errore": "^0.14.1",
    "incur": "^0.4.20",
    "maui": "npm:@tanishqkancharla/maui@0.0.13",
    "md4x": "^0.0.29",
    "purse-styles": "^0.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@get-halo/typescript-config": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}

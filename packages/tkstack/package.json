{
  "name": "tkstack",
  "version": "0.1.0",
  "description": "Serve a spec or code walkthrough as a local page",
  "license": "MIT",
  "author": "Tanishq Kancharla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanishqkancharla/halo-v2.git",
    "directory": "packages/tkstack"
  },
  "bin": {
    "tkstack": "./bin.js"
  },
  "files": [
    "bin.js",
    "index.html",
    "src",
    "vite.config.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "cli": "node --import tsx src/cli.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings src vite.config.ts bin.js",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix src vite.config.ts bin.js",
    "typecheck": "tsc --noEmit",
    "release": "pnpm publish --access public"
  },
  "dependencies": {
    "@pierre/diffs": "^1.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "beautiful-mermaid": "^1.1.3",
    "errore": "^0.14.1",
    "incur": "^0.4.20",
    "maui": "github:tanishqkancharla/maui#v0.0.5",
    "md4x": "^0.0.29",
    "purse-styles": "^0.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.21.0",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}

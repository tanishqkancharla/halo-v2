{
  "name": "tkstack",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "tkstack": "./src/cli.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "cli": "node --import tsx src/cli.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings src vite.config.ts",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix src vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pierre/diffs": "^1.3.5",
    "beautiful-mermaid": "^1.1.3",
    "errore": "^0.14.1",
    "incur": "^0.4.20",
    "maui": "github:tanishqkancharla/maui#5b5a450900317e7f04a33bd4c2ac8a592442e6f0",
    "md4x": "^0.0.29",
    "purse-styles": "^0.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}

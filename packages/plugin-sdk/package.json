{
  "name": "@halo/plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./view": "./src/view.ts",
    "./server": "./src/server.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings .",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {

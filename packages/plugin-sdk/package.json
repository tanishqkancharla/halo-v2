    "@orpc/server": "2.0.0-beta.29",
    "@sinclair/typebox": "^0.34.52",
    "errore": "^0.14.1",
    "maui": "npm:@tanishqkancharla/maui@0.0.2",
    "purse-styles": "^0.2.1",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "19.2.2",
    "react": "^19.2.8",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  }

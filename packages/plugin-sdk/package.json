{
  "name": "@halo/plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./view": "./src/view.ts",
    "./server": "./src/server.ts",
    "./host": "./src/PluginToolsFacade.ts",
    "./schema": "./src/schema.ts",
    "./storage": "./src/storage.ts",
    "./shared": "./src/AsyncEventQueue.ts",
    "./contract": "./src/contractPackage.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:types": "node scripts/buildBundledDts.mjs",
    "pack:contract": "node --experimental-strip-types scripts/packContract.ts",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings src scripts",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix src scripts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orpc/client": "2.0.0-beta.29",
    "@orpc/server": "2.0.0-beta.29",
    "@sinclair/typebox": "^0.34.52",
    "@tandem/core": "github:tanishqkancharla/tandem#path:packages/core",
    "@tandem/server": "github:tanishqkancharla/tandem#path:packages/server",
    "@tandem/types": "github:tanishqkancharla/tandem#path:packages/types",
    "errore": "^0.14.1",
    "maui": "npm:@tanishqkancharla/maui@0.0.11",
    "purse-styles": "^0.2.1",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "react": "^19.2.8",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  }
}
